with "../brickpi3.gpr";
project Brickpi3.Examples is
   for Languages use ("Ada","Python");
   for Source_Dirs use ("src/**",".");
   for Object_Dir use ".obj";
   for Main use project'Main &  "info.adb";
   for Main use project'Main &  "motors.adb";
   for Main use project'Main &  "sensors_ev3.adb";
   for Main use project'Main &  "sensors_nxt.adb";
   for Exec_Dir use "bin";

   package Compiler is
      for Driver ("Python") use "";


   end Compiler;

   package Naming is
      for Implementation_Suffix("Python") use ".py";


   end Naming;

   package  Brick is
      for Machine use "brickpi";
      for Dir use     "BrickPi3";
      for Main use    "bin/info";
   end  Brick;

end brickpi3.Examples;
