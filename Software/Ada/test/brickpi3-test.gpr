with "../brickpi3.gpr";
with "aunit.gpr";
with "gnatcoll.gpr";

project Brickpi3.Test is

   for Source_Dirs use ("src");
   for Object_Dir use ".obj";
   for Exec_Dir use "bin";
   for Main use ("brickpi3-test-simple-main.ads");


   package  IDE is
      for Read_Only use "False";
   end  IDE;

   package  Brick is
      for Machine use "brickpi";
      for Dir use     "BrickPi3/Software/Ada/test";
   end  Brick;

end Brickpi3.Test;
