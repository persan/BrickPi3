with "../brickpi3.gpr";
with "aunit.gpr";
with "gnatcoll.gpr";

project Brickpi3.Test is
   for Source_Dirs use ("src/**");
   for Object_Dir use ".obj";
   for Exec_Dir use "bin";
   for Main use project'Main & ("brickpi3-test-simple-main.ads");


   package  Remote_Test is
      for Remote_Machine use ("brickpi");
      for Remote_Dir use ("BrickPi3/Software/Ada/test");
   end  Remote_Test;

end Brickpi3.Test;
