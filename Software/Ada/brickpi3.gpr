library project BrickPi3 is
   for Source_Dirs use ("src");
   TARGET :=project'Target;
   case  Target is
      when "x86_64-w64-mingw32" | "x86_64-window" =>
         for Source_Dirs use project'Source_Dirs & ("src/host");
      when others =>
         null;
   end case;
   for Object_Dir use ".obj";
   for Library_Name use project'Name;
   for Library_Dir use "lib";
end BrickPi3;
